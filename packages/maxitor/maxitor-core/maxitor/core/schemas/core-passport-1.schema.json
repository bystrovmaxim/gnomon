{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bystrovmaxim/gnomon/packages/maxitor/maxitor-core/maxitor/core/schemas/core-passport-1.schema.json",
  "title": "Maxitor core passport, format 1",
  "description": "maxitor-core.yaml: the core's identity, the formats of a plugin's files it reads and the SDK major it is built with. Closed: an unknown field is an error.",
  "type": "object",
  "additionalProperties": false,
  "required": ["passport", "id", "reads", "sdk"],
  "properties": {
    "passport": { "const": 1, "description": "The format of this file." },
    "id": { "const": "maxitor", "description": "The core's identity." },
    "reads": {
      "type": "object",
      "description": "Each kind of a plugin's file and the formats of it the core reads.",
      "additionalProperties": false,
      "required": ["plugin-passport", "navigation", "foreign-keys"],
      "properties": {
        "plugin-passport": { "$ref": "#/$defs/formats" },
        "navigation": { "$ref": "#/$defs/formats" },
        "foreign-keys": { "$ref": "#/$defs/formats" }
      }
    },
    "sdk": { "type": "integer", "minimum": 1, "description": "The major version of maxitor-plugin-sdk the core is built with." }
  },
  "$defs": {
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    }
  }
}
