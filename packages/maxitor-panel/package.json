    "./panel.css": "./src/panel.css",
    "./address": "./src/shell/address.ts"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@maxitor/tokens": "file:../maxitor-tokens"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  }
