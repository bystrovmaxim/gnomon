{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bystrovmaxim/gnomon/packages/maxitor-plugin-template/checks/schemas/plugin-passport-1.schema.json",
  "title": "Maxitor plugin passport, format 1",
  "description": "maxitor-plugin.yaml: who a plugin is and what it needs. Every object is closed: an unknown field is an error.",
  "type": "object",
  "additionalProperties": false,
  "required": ["passport", "id", "name", "title", "description", "version", "requires", "backend", "frontend"],
  "properties": {
    "passport": { "const": 1, "description": "The format of this file." },
    "id": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
      "description": "The global identifier in reverse domain notation; never changes."
    },
    "name": {
      "type": "string",
      "pattern": "^(?!pg_)[a-z][a-z0-9_]{1,30}$",
      "not": { "enum": ["core", "public", "information_schema", "maxitor", "api", "p", "w", "auth", "static", "admin", "root"] },
      "description": "The name in one installation: the schema, the role plg_<name>, the paths /p/<name> and /w/<name>."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "version": { "$ref": "#/$defs/version" },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxitor"],
      "properties": {
        "maxitor": { "$ref": "#/$defs/range" },
        "node": { "$ref": "#/$defs/range" }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dependency" },
      "description": "Plugins this one cannot work without."
    },
    "roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "$ref": "#/$defs/identifier" },
          "description": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "migrate"],
      "properties": {
        "app": { "$ref": "#/$defs/entry" },
        "migrate": { "$ref": "#/$defs/entry" }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "navigation"],
      "properties": {
        "build": { "$ref": "#/$defs/path" },
        "navigation": { "$ref": "#/$defs/path" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mechanics": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "foreign_keys": { "$ref": "#/$defs/path" }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Strictly x.y.z."
    },
    "range": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(==|!=|>=|<=|>|<|~=)[0-9]+(\\.[0-9]+)*(,(==|!=|>=|<=|>|<|~=)[0-9]+(\\.[0-9]+)*)*$",
      "description": "A version range written as pip writes it, without spaces: >=2.1,<3."
    },
    "entry": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*:[a-z_][a-z0-9_]*$",
      "description": "module:function."
    },
    "path": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^(?!.*\\.\\.)[a-z_][a-z0-9_./-]*$",
      "description": "A path inside the Python package's folder; never climbs out of it."
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source"],
      "properties": {
        "id": { "type": "string", "maxLength": 200, "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
        "version": { "$ref": "#/$defs/range" },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["pip"],
              "properties": {
                "pip": { "type": "string", "pattern": "^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$" },
                "index": { "type": "string", "pattern": "^https://[^\\s]+$" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["wheel", "sha256"],
              "properties": {
                "wheel": { "type": "string", "pattern": "^https://[^\\s]+\\.whl$" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          ]
        }
      }
    }
  }
}
